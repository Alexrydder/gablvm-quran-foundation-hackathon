/**
 * Implements hook_views_query_alter().
 *
 * Reorders event status sort so Ongoing events appear first:
 * Ongoing (tid 2) → Upcoming (tid 1) → Past (tid 3).
 */
function gablvm_core_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() !== 'events') {
    return;
  }

  // Look up taxonomy term IDs dynamically to avoid hardcoding.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $status_tids = [];
  foreach (['Live', 'Ongoing', 'Upcoming', 'Past', 'Concluded'] as $name) {
    $terms = $term_storage->loadByProperties(['vid' => 'event_status', 'name' => $name]);
    $term = reset($terms);
    if ($term) {
      $status_tids[$name] = (int) $term->id();
    }
  }
  // Require at least the core three statuses.
  if (!isset($status_tids['Ongoing'], $status_tids['Upcoming'], $status_tids['Past'])) {
    return;
  }

  $tid_ongoing = $status_tids['Ongoing'];
  $tid_upcoming = $status_tids['Upcoming'];
  $tid_past = $status_tids['Past'];

  // Ensure field tables are joined even when a user clicks a different column
  // header to sort (e.g. ?order=title). Without this, the CASE expressions
  // below reference columns that don't exist in the query, causing SQL errors.
  $status_alias = $query->ensureTable('node__field_event_status');
  $date_alias_tbl = $query->ensureTable('node__field_event_date');
  if (!$status_alias || !$date_alias_tbl) {
    return;
  }

  // Add a CASE expression to control status display order.
  // Live events sort first (weight -1), then Ongoing, Upcoming, Past, Concluded.
  $case_parts = ["{$tid_ongoing} THEN 0", "{$tid_upcoming} THEN 1", "{$tid_past} THEN 2"];
  if (isset($status_tids['Live'])) {
    array_unshift($case_parts, "{$status_tids['Live']} THEN -1");
  }
  if (isset($status_tids['Concluded'])) {
    $case_parts[] = "{$status_tids['Concluded']} THEN 3";
  }
  $when_clauses = implode(' WHEN ', $case_parts);
  $expression = "CASE {$status_alias}.field_event_status_target_id WHEN {$when_clauses} ELSE 99 END";
  $alias = $query->addField(NULL, $expression, 'status_weight');

  // Remove the default status sort and replace with our custom weight.
  foreach ($query->orderby as $key => $orderby) {
    if (isset($orderby['field']) && strpos($orderby['field'], 'field_event_status_target_id') !== FALSE) {
      $query->orderby[$key]['field'] = $alias;
      break;
    }
  }

  // Sort date within groups: Upcoming/Ongoing/Live ASC (soonest first),
  // Past/Concluded DESC (most recent first).
  $past_tids = [$tid_past];
  if (isset($status_tids['Concluded'])) {
    $past_tids[] = $status_tids['Concluded'];
  }
  $past_in = implode(',', $past_tids);
  $date_sort = "CASE WHEN {$status_alias}.field_event_status_target_id IN ({$past_in}) THEN -UNIX_TIMESTAMP({$date_alias_tbl}.field_event_date_value) ELSE UNIX_TIMESTAMP({$date_alias_tbl}.field_event_date_value) END";
  $date_alias = $query->addField(NULL, $date_sort, 'date_weight');

  // Replace the default date sort with our conditional sort.
  foreach ($query->orderby as $key => $orderby) {
    if (isset($orderby['field']) && strpos($orderby['field'], 'field_event_date') !== FALSE) {
      $query->orderby[$key]['field'] = $date_alias;
      $query->orderby[$key]['direction'] = 'ASC';
      break;
    }
  }
}

/**
 * Implements hook_preprocess_views_view_table().
 *
 * Customizes status group headings on the events view for accessibility:
 * strips the field label prefix, appends " Events", and wraps in <h2>.
 */
function gablvm_core_preprocess_views_view_table(&$variables) {
  $view = $variables['view'];
  if ($view->id() !== 'events') {
    return;
  }

  if (!empty($variables['title'])) {
    $title = trim((string) $variables['title']);
    // Strip the "Status: " label prefix added by the rendered field.
    if (strpos($title, 'Status:') === 0) {
      $title = trim(substr($title, 7));
    }
    // Append " Events" if not already present.
    if (strpos($title, ' Events') === FALSE) {
      $title .= ' Events';
    }
    // Set clean title text — the template renders it as <h2> before the table.
    $variables['title'] = $title;
    // Clear caption so the heading doesn't also appear inside the table.
    $variables['caption'] = '';
    $variables['caption_needed'] = FALSE;
  }
}


/**
 * Validation handler for contact form.
 *
 * Subject is required only if no category is selected. Also prepends the
 * category label to the subject during validation so it is available to
 * the default submit/save handler that sends the email.
 */
function _gablvm_core_contact_form_validate(&$form, FormStateInterface $form_state) {
  $category = $form_state->getValue('category');
  $subject = trim($form_state->getValue(['subject', 0, 'value']) ?? '');

  if (empty($category) && empty($subject)) {
    $form_state->setErrorByName('subject', t('Please select a category or enter a subject.'));
    return;
  }

  // Prepend the category label to the subject here (during validation)
  // so it is part of the entity when Drupal's default submit handler
  // saves and sends the email.
  if ($category) {
    $labels = [
      'general' => 'General Inquiry',
      'accessibility' => 'Accessibility',
      'feedback' => 'Feedback',
      'bug_report' => 'Bug Report',
      'support' => 'Support Request',
      'partnership' => 'Partnership',
      'other' => 'Other',
    ];
    $label = $labels[$category] ?? $category;

    if ($subject) {
      $form_state->setValue(['subject', 0, 'value'], "[$label] $subject");
    }
    else {
      $form_state->setValue(['subject', 0, 'value'], $label);
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for simplenews_subscriber_validate.
 *
 * Upstream simplenews redirects anonymous submitters to /user/{uid}/simplenews
 * when the email matches an existing user account. That route requires login,
 * so anonymous visitors hit 403 and the "Please log in" status message is lost
 * behind the access-denied page. We replace the submit handler so a tokenized
 * management link is emailed to the address regardless of any user-account
 * association, which is what the form's success message already promises.
 */
function gablvm_core_form_simplenews_subscriber_validate_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#submit'] = ['gablvm_core_simplenews_validate_submit'];
  }
}

/**
 * Replacement submit handler for the simplenews validate (manage subscriptions) form.
 */
function gablvm_core_simplenews_validate_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $mail = trim($form_state->getValue('mail'));
  $subscriber = \Drupal\simplenews\Entity\Subscriber::loadByMail($mail);
  if ($subscriber && $subscriber->isActive()) {
    $mailer = \Drupal::service('simplenews.mailer');
    $mail_manager = \Drupal::service('plugin.manager.mail');
    $params = [
      'from' => $mailer->getFrom(),
      'context' => ['simplenews_subscriber' => $subscriber],
    ];
    $mail_manager->mail('simplenews', 'validate', $subscriber->getMail(), $subscriber->getLangcode(), $params, $params['from']['address']);
  }
  // Always show the same message regardless of whether the email exists,
  // so the form does not disclose subscriber existence.
  \Drupal::messenger()->addStatus(t('If %mail is subscribed, an email will be sent with a link to manage your subscriptions.', ['%mail' => $mail]));
  $form_state->setRedirect('<front>');
}

/**
 * Implements hook_mail_alter().
 *
 * Inject Reply-To: support@gablvm.org on every outbound Drupal email that
 * does not already specify a Reply-To. Mirrors the gablvm-mail wrapper so
 * users who hit Reply on a transactional or newsletter message reach a
 * human, even though the From address (noreply@, newsletter@, security@)
 * is unmonitored. Apple/Stripe/Anthropic pattern.
 */
function gablvm_core_mail_alter(&$message) {
  if (!empty($message['headers']['Reply-To'])) {
    return;
  }
  $message['headers']['Reply-To'] = 'support@gablvm.org';
}
